# Local dev: SQLite (no server needed). Production: set DATABASE_ADAPTER=postgres and a dedicated database.
DATABASE_ADAPTER=sqlite
DATABASE_URI=file:./.data/affirmate.db
# Production example: DATABASE_ADAPTER=postgres / DATABASE_URI=postgresql://affirmate:change-me@127.0.0.1:5432/affirmate
PAYLOAD_SECRET=replace-with-a-random-secret-at-least-32-characters
# Public origin without trailing slash (canonical, hreflang, sitemap, OG). Domain final: see docs/OPEN-QUESTIONS.md #1.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3100
MEDIA_DIR=media
# Contact form email (step 6). Leave empty to store inquiries without sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Affirmate Administrative
INQUIRY_RECIPIENTS=info@affirmate.co.id
# Only for npm run setup:admin. Never commit real values.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Draft preview secret shared with the CMS preview button.
PREVIEW_SECRET=replace-with-another-random-secret
# npm run seed keeps later CMS edits unless SEED_OVERWRITE=true.
SEED_OVERWRITE=false
