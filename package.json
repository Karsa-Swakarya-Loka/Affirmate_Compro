{
  "name": "affirmate-administrative",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "predev": "npm run generate",
    "build": "next build",
    "prebuild": "npm run generate",
    "start": "next start",
    "lint": "eslint src scripts next.config.ts",
    "typecheck": "tsc --noEmit",
    "generate": "payload generate:types && payload generate:importmap",
    "payload": "payload",
    "migrate:create": "payload migrate:create",
    "migrate": "payload migrate",
    "migrate:status": "payload migrate:status",
    "seed": "tsx src/seed/index.ts",
    "setup:admin": "tsx scripts/create-admin.ts",
    "verify:cms": "tsx scripts/verify-cms.ts",
    "media:refresh": "tsx scripts/refresh-media.ts",
    "clients:publish": "tsx scripts/publish-clients.ts",
    "tokens": "node scripts/build-tokens.mjs",
    "preview": "node scripts/build-preview.mjs",
    "map": "python scripts/build-map-svg.py",
    "content:export": "tsx scripts/export-content.ts",
    "content:import": "tsx scripts/import-content.ts",
    "hosting:env": "node scripts/hosting-env.mjs",
    "hosting:pull": "git pull --ff-only && git log --oneline -1",
    "hosting:unpack": "tar -xf $HOME/export-content.zip -C $HOME && ls $HOME/export-content | head",
    "hosting:migrate": "NODE_OPTIONS=--disable-wasm-trap-handler payload migrate",
    "hosting:import": "NODE_OPTIONS=--disable-wasm-trap-handler tsx scripts/import-content.ts $HOME/export-content",
    "hosting:status": "git log --oneline -1 && node -v && ls -a && df -h . && free -m",
    "hosting:data": "unzip -o $HOME/hosting-data.zip -d . && ls -la .data && ls media | wc -l",
    "hosting:next": "cat $HOME/next-build.tar.gz.part* > $HOME/next-build.tar.gz && rm -rf .next && mkdir .next && tar -xzf $HOME/next-build.tar.gz -C .next && rm -f $HOME/next-build.tar.gz.part* && ls .next | head -20",
    "hosting:ps": "ps -u $(whoami) -o pid,ppid,nlwp,etimes,rss,cmd --sort=-etimes | head -40",
    "hosting:kill-app": "pkill -f 'server[.]cjs'; sleep 3; ps -u $(whoami) -o pid,nlwp,etimes,cmd | grep -c 'server[.]cjs' || echo 'no app process left'",
    "hosting:clean": "rm -rf $HOME/export-content $HOME/export-content.zip $HOME/hosting-data.zip $HOME/next-build.tar.gz $HOME/next-build.tar.gz.part* $HOME/repositories/Affirmate_Compro && ls -a $HOME && du -sh $HOME/repositories/affirmate"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/db-sqlite": "3.90.2",
    "@payloadcms/email-nodemailer": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-vercel-blob": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@phosphor-icons/react": "2.1.10",
    "dotenv": "16.4.7",
    "graphql": "16.11.0",
    "next": "16.4.2",
    "payload": "3.90.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.2",
    "lighthouse": "12.8.2",
    "tsx": "4.22.4",
    "typescript": "5.7.3"
  }
}
