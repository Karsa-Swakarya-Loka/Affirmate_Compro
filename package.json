{
  "name": "affirmate-administrative",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "predev": "npm run generate",
    "build": "next build",
    "prebuild": "npm run generate",
    "start": "next start",
    "lint": "eslint src scripts next.config.ts",
    "typecheck": "tsc --noEmit",
    "generate": "payload generate:types && payload generate:importmap",
    "payload": "payload",
    "migrate:create": "payload migrate:create",
    "migrate": "payload migrate",
    "migrate:status": "payload migrate:status",
    "seed": "tsx src/seed/index.ts",
    "setup:admin": "tsx scripts/create-admin.ts",
    "verify:cms": "tsx scripts/verify-cms.ts",
    "tokens": "node scripts/build-tokens.mjs",
    "preview": "node scripts/build-preview.mjs",
    "map": "python scripts/build-map-svg.py"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/db-sqlite": "3.90.2",
    "@payloadcms/email-nodemailer": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-vercel-blob": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@phosphor-icons/react": "2.1.10",
    "dotenv": "16.4.7",
    "graphql": "16.11.0",
    "next": "16.4.0",
    "payload": "3.90.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.0",
    "lighthouse": "12.8.2",
    "tsx": "4.22.4",
    "typescript": "5.7.3"
  }
}
